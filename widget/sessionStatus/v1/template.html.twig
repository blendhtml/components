{% block container %}

    <div
            id="{{ self.id }}"
            data-bhtml-draggable
            data-open-modal="session-status"
            class="fixed z-50 flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-2 py-1.5 shadow-md select-none cursor-grab active:cursor-grabbing"
    >
        {% if _COOKIE['blendhtml_notrack'] %}
            <i
                    class="fa-solid fa-eye-slash text-zinc-700"
                    title="No tracking"
                    aria-label="No tracking"
            ></i>
        {% else %}
            <i
                    class="fa-solid fa-hand-pointer text-zinc-700"
                    title="Open session status modal"
                    aria-label="Open session status modal"
            ></i>
        {% endif %}
    </div>

{% endblock %}