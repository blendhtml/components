{% block container %}
<aside
        data-modal="{% block modalTitle %}center{% endblock %}"
        data-modal-type="center"
        class="fixed left-1/2 top-1/2 z-50 w-96 -translate-x-1/2 -translate-y-1/2 scale-95 rounded-lg bg-white shadow-2xl opacity-0 transition-all duration-300"
>
    <div class="flex items-center justify-between p-4">
        {% block modalHeader %}<div></div>{% endblock %}
        <button data-close-modal>✕</button>
    </div>
    {% block modalContents %}{% endblock %}
</aside>
{% endblock %}