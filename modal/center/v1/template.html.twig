{% block container %}
<aside
        id="{{ self.id }}"
        data-modal="{% block modalTitle %}center{% endblock %}"
        data-modal-type="center"
        {% block modalConfigs %}{% endblock %}
        class="{{ self.style.container is defined ? self.style.container : 'fixed left-1/2 top-1/2 z-50 w-96 -translate-x-1/2 -translate-y-1/2 scale-95 rounded-lg bg-white shadow-2xl opacity-0 transition-all duration-300' }}"
>
    <div class="{{ self.style.header is defined ? self.style.header : 'flex items-start justify-between p-4' }}">
        {% block modalHeader %}<div></div>{% endblock %}
        {% block closingButton %}<button data-close-modal class="{{ self.style.closingButton is defined ? self.style.closingButton : '' }}">✕</button>{% endblock %}
    </div>
    {% block modalContents %}{% endblock %}
</aside>
{% endblock %}
