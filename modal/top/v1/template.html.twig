{% block container %}
<aside
        id="{{ self.id }}"
        data-modal="{% block modalTitle %}top{% endblock %}"
        data-modal-type="top"
        {% block modalConfigs %}{% endblock %}
        class="{{ self.style.container is defined ? self.style.container : 'fixed left-0 top-0 z-50 w-full -translate-y-full bg-white shadow-xl transition-transform duration-300' }}"
>
    <div class="{{ self.style.header is defined ? self.style.header : 'flex items-start justify-between p-4' }}">
        {% block modalHeader %}<div></div>{% endblock %}
        {% block closingButton %}<button data-close-modal class="{{ self.style.closingButton is defined ? self.style.closingButton : '' }}">✕</button>{% endblock %}
    </div>
    {% block modalContents %}{% endblock %}
</aside>
{% endblock %}
